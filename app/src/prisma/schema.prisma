datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Shot {
  id              String   @id @default(uuid())
  period          Int
  position        String
  location        Float[]
  playPattern     String   @map("play_pattern")
  underPressure   Boolean  @default(false) @map("under_pressure")
  shotType        String   @map("shot_type")
  shotBodyPart    String   @map("shot_body_part")
  shotTechnique   String   @map("shot_technique")
  shotFirstTime   Boolean  @default(false) @map("shot_first_time")
  shotDeflected   Boolean  @default(false) @map("shot_deflected")
  shotFreezeFrame Json?    @map("shot_freeze_frame")
  shotAerialWon   Boolean  @default(false) @map("shot_aerial_won")
  shotStatsbombXg Float    @map("shot_statsbomb_xg")
  xg              Float    @map("xG")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([position])
  @@index([shotType])
  @@map("shots")
}